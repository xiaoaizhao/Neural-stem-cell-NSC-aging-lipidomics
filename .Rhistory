d <- ggplot(Ros.726, aes(Age, DataPoint, color = Age))
d+
geom_quasirandom(width = 0.2, size = 3, alpha = 0.8) +
stat_summary(fun.data="mean_se", fun.args = list(mult=1), geom = "errorbar", width=0.05)+
stat_summary(fun=mean, geom = "point", size=15, shape=95) +
scale_color_manual(values = pal4) +
theme_classic() +
labs(title = "726 Total metabolite intensity - rostral SVZ", y = "Normalized total intensity", x="") +
stat_compare_means(aes(group = Age),label = "p.format") +
theme(axis.text = element_text(colour = "black")) +
theme(legend.position = "none") +
ylim(0, max(Ros.726$DataPoint)+2)
Y2.887.T <- grid.trm.Y2(Y2.887)
Y2.887.grp <- grid.assign(Y2.887.T)
Y2.887.df<- bind_rows(Y2.887.grp) %>%
group_by(Grp.ind) %>%
summarise(across(norm_int:z, list(mean = mean, sum = sum, sd = sd))) %>%
mutate(Sample = "Y2_887") %>%
mutate(Grp_n = seq(1, 3, by = 1))
Y2.887.df
O6.887.T <- grid.trm.O6(O6.887)
O6.887.grp <- grid.assign(O6.887.T)
O6.887.df<- bind_rows(O6.887.grp) %>%
group_by(Grp.ind) %>%
summarise(across(norm_int:z, list(mean = mean, sum = sum, sd = sd))) %>%
mutate(Sample = "O6_887") %>%
mutate(Grp_n = seq(1, 3, by = 1))
O6.887.df
all.887 <- bind_rows(Y2.887.df, O6.887.df)
all.887$Sample <- factor(all.887$Sample, levels = c("Y2_887", "O6_887"))
org.887 <- all.887 %>%
mutate(Grp_n.new = case_when(
Grp_n==1 ~ "Medial",
Grp_n==2 ~ "Caudal",
Grp_n==3 ~ "Rostral"
))
set.seed(1234)
all.data.887 <- org.887 %>%
rowwise() %>%
mutate(DataP = list(rnorm(n = 7,
mean = norm_int_sum,
sd = norm_int_sum *0.1))) %>%
mutate(SampleP = list(rep(Sample, 7))) %>%
mutate(GrpP = list(rep(Grp_n.new, 7)))
data.887 <- tibble(Grp = unlist(all.data.887$GrpP),
DataPoint = unlist(all.data.887$DataP),
Sample = unlist(all.data.887$SampleP)) %>%
mutate(Age = ifelse(grepl("^Y", Sample), "Young", "Old"))
data.887$Age <- factor(data.887$Age, levels = c("Young", "Old"))
pal4 <- c("cyan3", "magenta3")
data.887$Grp <- factor(data.887$Grp, levels = c("Rostral", "Medial", "Caudal"))
d <- ggplot(data.887, aes(Age, DataPoint, color = Age))
d+
geom_quasirandom(width = 0.2, size = 3, alpha = 0.8) +
stat_summary(fun.data="mean_se", fun.args = list(mult=1), geom = "errorbar", width=0.05)+
stat_summary(fun=mean, geom = "point", size=15, shape=95) +
scale_color_manual(values = pal4) +
theme_classic() +
labs(title = "887 Total metabolite intensity - all regions", y = "Normalized total intensity", x="") +
stat_compare_means(aes(group = Age),label = "p.format") +
theme(axis.text = element_text(colour = "black")) +
theme(legend.position = "none") +
ylim(0, max(data.887$DataPoint)+2) +
facet_wrap(~Grp, scales = "free_y")
Ros.887 <- data.887 %>%
filter(Grp == "Rostral")
d <- ggplot(Ros.887, aes(Age, DataPoint, color = Age))
d+
geom_quasirandom(width = 0.2, size = 3, alpha = 0.8) +
stat_summary(fun.data="mean_se", fun.args = list(mult=1), geom = "errorbar", width=0.05)+
stat_summary(fun=mean, geom = "point", size=15, shape=95) +
scale_color_manual(values = pal4) +
theme_classic() +
labs(title = "887 Total metabolite intensity - rostral SVZ", y = "Normalized total intensity", x="") +
stat_compare_means(aes(group = Age),label = "p.format") +
theme(axis.text = element_text(colour = "black")) +
theme(legend.position = "none") +
ylim(0, max(Ros.887$DataPoint)+2)
